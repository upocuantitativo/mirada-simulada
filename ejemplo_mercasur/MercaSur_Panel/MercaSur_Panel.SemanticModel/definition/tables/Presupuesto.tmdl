table Presupuesto
	lineageTag: 3da996dd-4b25-5cf5-b04c-bbdec9b67267

	column id_tienda
		dataType: string
		isHidden
		lineageTag: 06cac344-bdf1-56f6-8579-16448009e151
		summarizeBy: none
		sourceColumn: id_tienda

	column linea
		dataType: string
		lineageTag: 088d5db5-b700-5693-a334-143cf06d130c
		summarizeBy: none
		sourceColumn: linea

	column semestre
		dataType: string
		lineageTag: 7a6d4f67-3550-5afb-be07-f8c4edc00924
		summarizeBy: none
		sourceColumn: semestre

	column objetivo_usd
		dataType: double
		lineageTag: b8161980-af95-5e28-9d56-2a41acee869b
		summarizeBy: sum
		sourceColumn: objetivo_usd

	column Anio
		dataType: int64
		isHidden
		lineageTag: 87de8c08-ab94-51bb-be80-1bc32dd2c2d2
		summarizeBy: none
		sourceColumn: Anio

	partition Presupuesto = m
		mode: import
		source =
			let
							Origen = Csv.Document(Binary.Decompress(Binary.FromText(
							"",
							BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
							Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
							Tipos = Table.TransformColumnTypes(Encabezados, {{"id_tienda", type text}, {"linea", type text}, {"semestre", type text}, {"objetivo_usd", type number}}, "en-US"),
							ConAnio = Table.AddColumn(Tipos, "Anio", each Number.From(Text.Start([semestre], 4)), Int64.Type)
			in
							ConAnio
