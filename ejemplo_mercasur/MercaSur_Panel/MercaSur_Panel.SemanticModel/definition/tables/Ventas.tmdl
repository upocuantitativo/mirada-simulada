table Ventas
	lineageTag: bf005a0f-e9ec-59b7-b25f-f30bef68457a

	measure Ventas = SUM ( Ventas[ventas_usd] )
		formatString: #,0
		lineageTag: 67f241e7-fe85-5a4c-90e0-ca2a7dcabf1c

	measure 'Ventas ultimo anio' = CALCULATE ( [Ventas], Anios[Anio] = MAX ( Anios[Anio] ) )
		formatString: #,0
		lineageTag: 935d56da-2f53-5c10-9355-88d8173068c6

	measure 'Ventas anio anterior' = CALCULATE ( [Ventas], Anios[Anio] = MAX ( Anios[Anio] ) - 1 )
		formatString: #,0
		lineageTag: c24a98db-7370-5fe9-ab2f-2b6a9d2bef4a

	measure Crecimiento = DIVIDE ( [Ventas ultimo anio] - [Ventas anio anterior], [Ventas anio anterior] )
		formatString: 0.0%
		lineageTag: 7cdac365-3bff-5661-94f8-03573550b86b

	measure 'Ventas comparables' = CALCULATE ( [Ventas], Tiendas[es_nueva] = "no" )
		formatString: #,0
		lineageTag: 137c19df-1c39-524c-b1a9-972be85202e1

	measure 'Crecimiento comparables' = VAR Actual = CALCULATE ( [Ventas comparables], Anios[Anio] = MAX ( Anios[Anio] ) ) VAR Previo = CALCULATE ( [Ventas comparables], Anios[Anio] = MAX ( Anios[Anio] ) - 1 ) RETURN DIVIDE ( Actual - Previo, Previo )
		formatString: 0.0%
		lineageTag: 3bf15a15-935c-5546-997d-24f26fe521b4

	measure 'Ventas tiendas nuevas' = CALCULATE ( [Ventas], Tiendas[es_nueva] <> "no" )
		formatString: #,0
		lineageTag: 9500e103-5be1-5e9a-88f9-b8ea8dc26381

	measure 'Ventas tiendas nuevas ultimo anio' = CALCULATE ( [Ventas tiendas nuevas], Anios[Anio] = MAX ( Anios[Anio] ) )
		formatString: #,0
		lineageTag: 1eb52d5e-06af-5e4d-968e-5e11ff093230

	measure Objetivo = SUM ( Presupuesto[objetivo_usd] )
		formatString: #,0
		lineageTag: bed95b55-0dec-5c71-b63b-730f8be53531

	measure Cumplimiento = DIVIDE ( [Ventas], [Objetivo] )
		formatString: 0.0%
		lineageTag: 7305cd0c-de7e-5e0d-b017-dc187e3fff5b

	measure 'Desviacion objetivo' = [Cumplimiento] - 1
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: a02ff5f0-b808-56f6-824f-e34764d75742

	measure 'Margen ponderado' = DIVIDE ( SUMX ( Ventas, Ventas[ventas_usd] * Ventas[margen_pct] / 100 ), [Ventas] )
		formatString: 0.0%
		lineageTag: 8cdd70e5-d03f-5953-b610-4e71a995f41b

	measure 'Titulo panel' = VAR T = [Crecimiento] VAR TC = [Crecimiento comparables] VAR Total = IF ( T < 0, "caen un ", "suben un " ) & FORMAT ( ABS ( T ), "0.0 %" ) VAR Comp = IF ( TC < 0, "caen un ", "suben un " ) & FORMAT ( ABS ( TC ), "0.0 %" ) RETURN IF ( NOT ISBLANK ( T ), "En " & MAX ( Anios[Anio] ) & " las ventas " & Total & IF ( SIGN ( T ) <> SIGN ( TC ), ", pero en las tiendas comparables ", " y en las tiendas comparables " ) & Comp, "Ventas de MercaSur 360: " & FORMAT ( [Ventas], "#,##0" ) & " USD" )
		lineageTag: d684db74-2ac5-5d05-9d65-1a2215fb1200

	column fecha
		dataType: string
		isHidden
		lineageTag: 3d0eb589-6466-5f33-954d-2b4f6ec0784a
		summarizeBy: none
		sourceColumn: fecha

	column id_tienda
		dataType: string
		isHidden
		lineageTag: 609f715f-66d6-5608-b886-813775c1a019
		summarizeBy: none
		sourceColumn: id_tienda

	column linea
		dataType: string
		lineageTag: 620ad00b-1496-5a01-ae11-558c2b1dc737
		summarizeBy: none
		sourceColumn: linea

	column unidades
		dataType: int64
		lineageTag: 2d0745b2-0304-5101-9601-ce40b33afe97
		summarizeBy: sum
		sourceColumn: unidades

	column ventas_usd
		dataType: double
		lineageTag: bbe66976-6dcf-5310-9b4b-75d283ac4e38
		summarizeBy: sum
		sourceColumn: ventas_usd

	column margen_pct
		dataType: double
		lineageTag: 8d150019-b5c5-58df-8af9-0415c1d1a114
		summarizeBy: none
		sourceColumn: margen_pct

	column Anio
		dataType: int64
		isHidden
		lineageTag: 1bd5adf5-35aa-585e-991c-6db633e041f5
		summarizeBy: none
		sourceColumn: Anio

	column Mes
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: ab5cd15b-2f4f-5b98-b306-65af060aa02a
		summarizeBy: none
		sourceColumn: Mes

	partition Ventas = m
		mode: import
		source =
			let
							Origen = Csv.Document(Binary.Decompress(Binary.FromText(
							"" &
				"" &
				"" &
				"" &
				"" &
				"",
							BinaryEncoding.Base64), Compression.Deflate), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
							Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
							Tipos = Table.TransformColumnTypes(Encabezados, {{"fecha", type text}, {"id_tienda", type text}, {"linea", type text}, {"unidades", Int64.Type}, {"ventas_usd", type number}, {"margen_pct", type number}}, "en-US"),
							Columnas = Table.SelectColumns(Tipos, {"fecha", "id_tienda", "linea", "unidades", "ventas_usd", "margen_pct"}),
							ConAnio = Table.AddColumn(Columnas, "Anio", each Number.From(Text.Start([fecha], 4)), Int64.Type),
							ConMes = Table.AddColumn(ConAnio, "Mes", each #date(Number.From(Text.Start([fecha], 4)), Number.From(Text.End([fecha], 2)), 1), type date)
			in
							ConMes
